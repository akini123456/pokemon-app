{
  "name": "tcg-merchant-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "firebase:emulators": "firebase emulators:start --only auth,firestore,functions,storage",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"functions/src/**/*.ts\" \"*.{json,md,html}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"functions/src/**/*.ts\" \"*.{json,md,html}\" \"docs/**/*.md\""
  },
  "dependencies": {
    "firebase": "^11.6.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "firebase-tools": "^14.0.0",
    "prettier": "^3.6.2",
    "typescript": "~5.7.3",
    "vite": "^6.2.0"
  }
}
