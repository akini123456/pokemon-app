# Copy to .env ONLY after creating your own Firebase project.
# Leave blank to run the local demo (no Firebase account required).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# Set to true to connect to LOCAL Firebase emulators, not production.
VITE_USE_FIREBASE_EMULATORS=false
